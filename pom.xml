<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.predatorray.candybox</groupId>
    <artifactId>candybox-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Candybox</name>
    <description>A distributed, S3-like object store whose storage engine is a distributed LSM tree built on Apache BookKeeper.</description>
    <inceptionYear>2026</inceptionYear>
    <url>https://github.com/predatorray/candybox</url>

    <!-- Project metadata below is required by Maven Central and inherited by every module. -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>predatorray</id>
            <name>Wenhao Ji</name>
            <email>predator.ray@gmail.com</email>
            <url>https://github.com/predatorray</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/predatorray/candybox.git</connection>
        <developerConnection>scm:git:git@github.com:predatorray/candybox.git</developerConnection>
        <url>https://github.com/predatorray/candybox</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/predatorray/candybox/issues</url>
    </issueManagement>

    <modules>
        <module>candybox-common</module>
        <module>candybox-bookkeeper</module>
        <module>candybox-coordination</module>
        <module>candybox-lsm</module>
        <module>candybox-protocol</module>
        <module>candybox-server</module>
        <module>candybox-client</module>
        <module>candybox-s3-gateway</module>
        <module>candybox-admin-api</module>
        <module>candybox-web</module>
        <module>candybox-integration-tests</module>
        <module>candybox-dist</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- dependency versions -->
        <bookkeeper.version>4.17.1</bookkeeper.version>
        <zookeeper.version>3.9.2</zookeeper.version>
        <curator.version>5.6.0</curator.version>
        <netty.version>4.1.118.Final</netty.version>
        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
        <jackson.version>2.18.2</jackson.version>
        <junit.version>5.10.2</junit.version>
        <assertj.version>3.27.7</assertj.version>

        <!-- plugin versions -->
        <surefire.version>3.2.5</surefire.version>
        <failsafe.version>3.2.5</failsafe.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <jar.plugin.version>3.4.1</jar.plugin.version>
        <assembly.plugin.version>3.7.1</assembly.plugin.version>
        <license.plugin.version>4.6</license.plugin.version>
        <jacoco.plugin.version>0.8.12</jacoco.plugin.version>
        <frontend.plugin.version>1.15.1</frontend.plugin.version>
        <os.plugin.version>1.7.1</os.plugin.version>
        <node.version>v20.18.0</node.version>
        <npm.version>10.9.0</npm.version>
        <source.plugin.version>3.3.1</source.plugin.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <gpg.plugin.version>3.2.8</gpg.plugin.version>
        <central.publishing.plugin.version>0.12.0</central.publishing.plugin.version>
        <versions.plugin.version>2.18.0</versions.plugin.version>
        <enforcer.plugin.version>3.5.0</enforcer.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- internal modules -->
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-bookkeeper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-coordination</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-lsm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-s3-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-admin-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.predatorray.candybox</groupId>
                <artifactId>candybox-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- third-party -->
            <!-- Align every Netty artifact (incl. those BookKeeper pulls transitively) to one version
                 so the gateway's codec-http and its siblings can't diverge on the IT classpath. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.bookkeeper</groupId>
                <artifactId>bookkeeper-server</artifactId>
                <version>${bookkeeper.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-framework</artifactId>
                <version>${curator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-recipes</artifactId>
                <version>${curator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-test</artifactId>
                <version>${curator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <!-- Jackson BOM aligns every jackson-* artifact pulled either directly or transitively
                 (e.g. by future modules) onto one version. candybox-admin-api consumes
                 jackson-databind for its small request-body parsing surface; this BOM keeps any
                 future addition (e.g. jackson-dataformat-yaml in tooling) on the same release
                 train. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- test -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- test dependencies available to every module -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Sets os.detected.*, the properties Netty's own POMs use to name their native artifacts.
             netty-handler declares the optional native OpenSSL provider as
             `netty-tcnative:${os.detected.classifier}`, and a module depending on netty-handler
             *directly* (candybox-protocol, candybox-server) has that optional edge walked by
             `dependency:go-offline` — the Dockerfile's dependency-warming layer — which then fails
             on the unresolved classifier. Nothing here reaches a compile or runtime classpath: the
             provider stays optional and pruned (we build SSLEngines from a JDK SSLContext and never
             select SslProvider.OPENSSL), it is only now nameable. -->
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os.plugin.version}</version>
            </extension>
        </extensions>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.mycila</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${source.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${javadoc.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${gpg.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central.publishing.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Code coverage. prepare-agent instruments the surefire (unit) JVM and writes
                 target/jacoco.exec; prepare-agent-integration instruments the failsafe (IT) forks
                 and writes target/jacoco-it.exec. Both set the `argLine` property: surefire/failsafe
                 pick it up automatically, except the integration-tests module which hardcodes an
                 argLine and must reference @{argLine} (see that module's pom). Per-module HTML reports
                 land in target/site/jacoco (unit) and target/site/jacoco-it (IT); the cross-module
                 aggregate is produced by candybox-integration-tests via report-aggregate. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report-integration</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>${maven.multiModuleProjectDirectory}/etc/license-header.txt</header>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                    <properties>
                        <project.inceptionYear>${project.inceptionYear}</project.inceptionYear>
                    </properties>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>license-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Publishing to Maven Central (https://central.sonatype.com). Activate with -Prelease; it
             attaches the -sources and -javadoc jars Central requires, GPG-signs every artifact and
             uploads one bundle through the Central Portal. Run it with -Pfrontend too, so the
             published candybox-web jar carries the dashboard. Needs a `central` server entry
             (Portal user token) in settings.xml and a GPG key: see RELEASING.md. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <!-- Don't fail the release over missing @param/@return tags; broken
                                 references and malformed HTML still fail. -->
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <!-- Lets CI sign with a key imported into a non-interactive agent. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <deploymentName>candybox-${project.version}</deploymentName>
                            <!-- Central limits each organization's monthly publishing by file count
                                 and total size, and checksum files count. Central requires only
                                 .md5 and .sha1, which keeps a release at about 170 files. -->
                            <checksums>required</checksums>
                            <!-- candybox-integration-tests is test scaffolding. The candybox-dist
                                 archives (about 95 MB each, bundling every runtime dependency) would
                                 exceed the monthly size limit on their own, so they go to GitHub
                                 Releases instead. -->
                            <excludeArtifacts>
                                <excludeArtifact>candybox-integration-tests</excludeArtifact>
                                <excludeArtifact>candybox-dist</excludeArtifact>
                            </excludeArtifacts>
                            <waitMaxTime>3600</waitMaxTime>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <!-- Read by central-publishing-maven-plugin: once the uploaded bundle validates,
                     release it and wait until it is live. Override with
                     -DautoPublish=false -DwaitUntil=validated to inspect the deployment in the
                     Portal and click Publish (or Drop) by hand, or -DskipUpload=true to only
                     build the bundle under target/central-publishing/. -->
                <autoPublish>true</autoPublish>
                <waitUntil>published</waitUntil>
            </properties>
        </profile>
    </profiles>
</project>
