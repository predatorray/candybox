{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "nameOverride",
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "commonEnv",
    "commonEnvFrom",
    "volumes",
    "volumeMounts",
    "podSecurityContext",
    "securityContext",
    "node",
    "gateway",
    "admin",
    "bookkeeper",
    "zookeeper",
    "externalZookeeper",
    "externalBookkeeper",
    "test"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "commonEnv": {
      "type": "array"
    },
    "commonEnvFrom": {
      "type": "array"
    },
    "volumes": {
      "type": "array"
    },
    "volumeMounts": {
      "type": "array"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "node": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "heapOpts": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "quorums": {
          "type": "object",
          "required": [
            "wal",
            "manifest",
            "sstable",
            "syrup"
          ],
          "additionalProperties": false,
          "properties": {
            "wal": {
              "type": "string",
              "pattern": "^[1-9][0-9]*/[1-9][0-9]*/[1-9][0-9]*$"
            },
            "manifest": {
              "type": "string",
              "pattern": "^[1-9][0-9]*/[1-9][0-9]*/[1-9][0-9]*$"
            },
            "sstable": {
              "type": "string",
              "pattern": "^[1-9][0-9]*/[1-9][0-9]*/[1-9][0-9]*$"
            },
            "syrup": {
              "type": "string",
              "pattern": "^[1-9][0-9]*/[1-9][0-9]*/[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "heapOpts": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "heapOpts": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "probeScheme": {
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        }
      }
    },
    "bookkeeper": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "heapOpts": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "ledgerRootPath": {
          "type": "string",
          "pattern": "^/[^/].*"
        },
        "zookeeperServers": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "journalSize": {
              "type": "string",
              "minLength": 1
            },
            "ledgerSize": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "zookeeper": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "externalZookeeper": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "string"
        }
      }
    },
    "externalBookkeeper": {
      "type": "object",
      "properties": {
        "metadataServiceUri": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "properties": {
        "env": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        }
      }
    }
  }
}
