<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.predatorray.candybox</groupId>
        <artifactId>candybox-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>
    <artifactId>candybox-charts</artifactId>
    <packaging>pom</packaging>
    <name>Candybox Helm chart</name>
    <properties>
        <helm.executable>helm</helm.executable>
        <candybox.charts.skip>false</candybox.charts.skip>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>package-helm-chart</id>
                        <phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${candybox.charts.skip}</skip>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/build.sh</argument>
                                <argument>${project.version}</argument>
                                <argument>${project.build.directory}</argument>
                                <argument>${helm.executable}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>attach-chart</id>
                        <phase>package</phase>
                        <goals><goal>attach-artifact</goal></goals>
                        <configuration>
                            <skipAttach>${candybox.charts.skip}</skipAttach>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/candybox-chart-${project.version}.tgz</file>
                                    <type>tgz</type>
                                    <classifier>helm</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
